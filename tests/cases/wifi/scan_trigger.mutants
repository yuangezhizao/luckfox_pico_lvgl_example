# Scan 主动扫描、延时读取与提示（spec §5.1 F1、N1）。
id: WIFI-F1-no-request
file: custom/custom_wifi.c
old:         _wifi_scan_request();
new:         _wifi_scanning_ssid();
tests: ^wifi\.scan_trigger\.

id: WIFI-F1-read-now
file: custom/custom_wifi.c
old: lv_timer_create(wifi_scan_read_timer_cb, WIFI_SCAN_READ_DELAY_MS, NULL)
new: lv_timer_create(wifi_scan_read_timer_cb, 0, NULL)
tests: ^wifi\.scan_trigger\.

id: WIFI-F1-no-reset
file: custom/custom_wifi.c
old:         lv_timer_reset(wifi_scan_read_timer);\n
new:
tests: ^wifi\.scan_trigger\.

id: WIFI-F1-many-timers
file: custom/custom_wifi.c
old:     if (wifi_scan_read_timer != NULL) {\n        lv_timer_reset(wifi_scan_read_timer);\n        return;\n    }\n
new:
tests: ^wifi\.scan_trigger\.

id: WIFI-N1-no-hint
file: custom/custom_wifi.c
old:         printf("wpa_cli scan: %s", reply);\n        wifi_hint_show(WIFI_UNREACHABLE_HINT);
new:         printf("wpa_cli scan: %s", reply);
tests: ^wifi\.scan_trigger\.
